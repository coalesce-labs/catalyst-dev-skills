#!/usr/bin/env node
import { verifyDoc } from "./lib.mjs";
const path = process.argv[2];
if (!path) { process.stderr.write("usage: verify-research <document>\n"); process.exit(2); }
try {
  const result = verifyDoc("research", path);
  process.stdout.write(JSON.stringify({ stage: "research", ...result }) + "\n");
  if (!result.ok) { process.stderr.write(result.errors.join("\n") + "\n"); process.exitCode = 1; }
} catch (error) { process.stderr.write(error.message + "\n"); process.exitCode = 2; }
